{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartbeat.local/schemas/integrations.schema.json",
  "title": "Heartbeat Integrations Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["collectors"],
  "properties": {
    "platform": {
      "description": "Observability platform that stores and shows Heartbeat's telemetry (ADR 0011). Heartbeat only writes OTLP to opentelemetry.endpoint and Prometheus exposition on /metrics; grafana selects Grafana dashboard and deep-link syntax and, later, the API's query adapters; generic is any other platform, for which dashboards, logs and alerting stay empty.",
      "type": "string",
      "enum": ["grafana", "generic"],
      "default": "grafana"
    },
    "dashboards": {
      "description": "The platform's UI (Grafana): base URL and dashboard and deep-link templates.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {"type": "string", "format": "uri"},
        "dashboard_templates": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "deep_link_templates": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "logs": {
      "description": "The platform's log query API (Loki). Heartbeat never writes logs here; they go through opentelemetry.endpoint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {"type": "string", "format": "uri"}
      }
    },
    "alerting": {
      "description": "The platform's alert API (Alertmanager).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {"type": "string", "format": "uri"}
      }
    },
    "opentelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri"}
      }
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "channel_type", "target_ref"],
        "properties": {
          "id": {"type": "string"},
          "channel_type": {"type": "string"},
          "target_ref": {"type": "string"},
          "credential_ref": {"type": "string"},
          "config": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "credential_refs": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "enabled": {"type": "boolean"},
          "credential_ref": {"type": "string"},
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "environment": {"type": "string"},
              "scrape_interval": {"type": "string", "description": "How often the collector runs a cycle (Go duration, default 30s). For outsystems_logs it is the poll interval."},
              "lag": {"type": "string", "description": "outsystems_logs only: how far behind now a read stops (Go duration, default 60s)."},
              "batch_limit": {"type": "integer", "minimum": 1, "maximum": 50000, "description": "outsystems_logs only: most rows one log-type query returns (default 5000)."},
              "initial_lookback": {"type": "string", "description": "outsystems_logs only: where a log type without a watermark starts, back from now (Go duration, default 15m)."},
              "log_timezone": {"type": "string", "description": "outsystems_logs only: IANA time zone the Instant column is stored in (default UTC)."},
              "target_names": {
                "type": "array",
                "items": {"type": "string"}
              },
              "probes": {
                "type": "array",
                "items": {"$ref": "#/$defs/probe"}
              },
              "targets": {
                "type": "array",
                "items": {"$ref": "#/$defs/target"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "query_template": {"type": "string"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 25000},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 100000, "description": "sqlserver only: the most rows the probe may return before it fails; default 10000."},
        "lag": {"type": "string", "description": "outsystems_logs only: this log type's lag, replacing the collector's (Go duration). A screen or cyclic_job row is written when the operation ends but Instant is its start, so set it above the longest screen request or timer."}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "port"],
      "properties": {
        "name": {"type": "string"},
        "environment": {"type": "string"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database_name": {"type": "string"},
        "credential_ref": {"type": "string"},
        "probes": {
          "type": "array",
          "items": {"$ref": "#/$defs/probe"}
        }
      }
    }
  }
}
