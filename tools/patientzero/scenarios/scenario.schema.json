{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gdpais/Heartbeat/tools/patientzero/scenarios/scenario.schema.json",
  "title": "PatientZero scenario",
  "description": "One fault scenario: the steps it runs, the fault of each step, and the signals it must produce. PatientZero validates every file at startup (internal/scenario); this schema is for editors and reviews. Format: tools/patientzero/scenarios/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "description", "steps"],
  "properties": {
    "version": { "const": 1, "description": "Format version." },
    "name": { "$ref": "#/$defs/name", "description": "The scenario's name; the file is <name>.yaml." },
    "description": { "type": "string", "minLength": 1, "description": "What the scenario injects and what it must show." },
    "load": {
      "enum": ["none", "smoke", "steady", "peak", "soak", "day"],
      "default": "steady",
      "description": "The k6 profile (load/patientzero.js) the driver runs during the scenario; none for no load."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/step" },
      "description": "Stretches of the run, one after another, each with or without a fault."
    },
    "signals": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/signal" },
      "description": "Expected signals, each checked within its window and recorded in the run journal."
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "A Go duration such as 90s or 2m30s."
    },
    "entryPoints": {
      "type": "array",
      "items": { "enum": ["OrderList", "PlaceOrder", "GetOrders"] },
      "uniqueItems": true,
      "description": "Entry points by Heartbeat's operation label; empty or absent for all."
    },
    "module": {
      "enum": ["PatientZero_API", "PatientZero_App", "PatientZero_Web"],
      "description": "A PatientZero module (eSpace): PatientZero_Web serves OrderList, PatientZero_App PlaceOrder, PatientZero_API GetOrders."
    },
    "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "duration"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "duration": { "$ref": "#/$defs/duration", "description": "More than 0, at most 24h." },
        "fault": { "$ref": "#/$defs/fault" }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["latency", "errors", "deploy", "sql-latency", "rotation", "commit-delay", "log-flood", "restart", "outage"], "description": "A type from the fault registry (README.md, \"Fault registry\")." },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "latency" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["delay"],
                "properties": {
                  "entry_points": { "$ref": "#/$defs/entryPoints" },
                  "delay": { "$ref": "#/$defs/duration", "description": "Added to every request hit; delay plus jitter at most 1m." },
                  "jitter": { "$ref": "#/$defs/duration", "description": "A random extra delay up to this." },
                  "ratio": { "$ref": "#/$defs/ratio", "default": 1, "description": "Share of the requests delayed." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "errors" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ratio"],
                "properties": {
                  "entry_points": { "$ref": "#/$defs/entryPoints" },
                  "ratio": { "$ref": "#/$defs/ratio", "description": "Share of the requests failed." },
                  "message": { "type": "string", "maxLength": 200, "description": "Ends the error row's Message, after \"injected by scenario: \"." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "deploy" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["module"],
                "anyOf": [{ "required": ["error_ratio"] }, { "required": ["delay"] }],
                "properties": {
                  "module": { "$ref": "#/$defs/module" },
                  "error_ratio": { "$ref": "#/$defs/ratio", "description": "Share of the module's requests the new version fails." },
                  "exception": { "type": "string", "maxLength": 200, "description": "The error row's Message; .NET's NullReferenceException message by default." },
                  "delay": { "$ref": "#/$defs/duration", "description": "Added to every request of the module; at most 1m." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "sql-latency" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["delay"],
                "properties": {
                  "entry_points": { "$ref": "#/$defs/entryPoints" },
                  "delay": { "$ref": "#/$defs/duration", "description": "How much longer the business statement runs in SQL Server; delay plus jitter at most 1m." },
                  "jitter": { "$ref": "#/$defs/duration", "description": "A random extra delay up to this." },
                  "ratio": { "$ref": "#/$defs/ratio", "default": 1, "description": "Share of the requests slowed." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "rotation" } } },
          "then": {
            "properties": {
              "params": { "type": "object", "additionalProperties": false, "maxProperties": 0, "description": "None: every log type's views move one cycle table on." }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "commit-delay" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["delay"],
                "properties": {
                  "delay": { "$ref": "#/$defs/duration", "description": "How long every request's log rows wait before they are committed; at most 10m." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["restart", "outage"] } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workload"],
                "properties": {
                  "workload": { "enum": ["db-collector", "loki", "otel-collector", "sqlserver"], "description": "The Heartbeat StatefulSet of that name, or SQL Server's container. A cluster fault: the host agent of the run applies it." }
                }
              }
            },
            "required": ["params"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "log-flood" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rows"],
                "properties": {
                  "entry_points": { "$ref": "#/$defs/entryPoints" },
                  "rows": { "type": "integer", "minimum": 1, "maximum": 200, "description": "Extra general rows each request logs." },
                  "bytes": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 1000, "description": "Length of each extra row's Message." }
                }
              }
            },
            "required": ["params"]
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "within"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "promql": { "type": "string", "minLength": 1, "description": "An instant PromQL query, run against Prometheus." },
        "logql": { "type": "string", "minLength": 1, "description": "An instant LogQL metric query, run against Loki, such as sum(count_over_time({...} |= \"x\" [2m])). A log query (lines, no metric) fails the evaluation." },
        "alert": { "type": "string", "minLength": 1, "description": "An alert name in Alertmanager." },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log_types"],
          "description": "A delivery check: Loki holds exactly the log rows PatientZero committed with an Instant from the start of from_step to the end of to_step, less those held back longer than lost_after. Its window opens at or after the end of to_step.",
          "properties": {
            "log_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["cyclic_job", "error", "extension", "general", "integration", "mobile_request", "request_event", "screen"] }
            },
            "from_step": { "$ref": "#/$defs/name", "description": "The step whose start opens the rows' window; the first step by default." },
            "to_step": { "$ref": "#/$defs/name", "description": "The step whose end closes the rows' window; the last step by default." },
            "lost_after": { "$ref": "#/$defs/duration", "description": "Rows a commit-delay fault held back longer than this must be missing from Loki: committed past the collector's lag, they are never read. Without it every row must be there." },
            "late_rows": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*(\\{[^{}]*\\})?$", "description": "A Prometheus counter selector without log_type, such as heartbeat_outsystems_late_rows_total{collector=\"patientzero\"}: per log type, it must have grown by exactly the rows lost, from the start of from_step to the evaluation. Needs lost_after." }
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "additionalProperties": { "type": "string" },
          "description": "Alert signals only: labels the alert must carry."
        },
        "state": { "enum": ["firing", "resolved"], "description": "Alert signals only." },
        "condition": {
          "type": "string",
          "pattern": "^\\s*(present|absent|(>=|<=|==|!=|>|<)\\s*[-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+)?)\\s*$",
          "description": "Query signals only: present, absent, or a comparison such as > 0.25. A comparison must hold for every series returned, and fails on none."
        },
        "step": { "$ref": "#/$defs/name", "description": "The step the window is anchored on; the first step with a fault by default." },
        "from": { "enum": ["start", "end"], "default": "start", "description": "The window opens at the start or the end of the step." },
        "within": { "$ref": "#/$defs/duration", "description": "How long the window stays open; at most 6h." },
        "mode": {
          "enum": ["eventually", "always"],
          "default": "eventually",
          "description": "eventually: passes the first time the condition holds in the window. always: must hold at every evaluation until the window closes."
        }
      },
      "oneOf": [
        { "required": ["promql"], "not": { "anyOf": [{ "required": ["logql"] }, { "required": ["alert"] }, { "required": ["delivery"] }] } },
        { "required": ["logql"], "not": { "anyOf": [{ "required": ["promql"] }, { "required": ["alert"] }, { "required": ["delivery"] }] } },
        { "required": ["alert"], "not": { "anyOf": [{ "required": ["promql"] }, { "required": ["logql"] }, { "required": ["delivery"] }] } },
        { "required": ["delivery"], "not": { "anyOf": [{ "required": ["promql"] }, { "required": ["logql"] }, { "required": ["alert"] }] } }
      ],
      "allOf": [
        {
          "if": { "required": ["alert"] },
          "then": { "required": ["state"], "not": { "required": ["condition"] } }
        },
        {
          "if": { "anyOf": [{ "required": ["promql"] }, { "required": ["logql"] }] },
          "then": { "required": ["condition"], "not": { "anyOf": [{ "required": ["state"] }, { "required": ["labels"] }] } }
        },
        {
          "if": { "required": ["delivery"] },
          "then": { "not": { "anyOf": [{ "required": ["condition"] }, { "required": ["state"] }, { "required": ["labels"] }] } }
        }
      ]
    }
  }
}
