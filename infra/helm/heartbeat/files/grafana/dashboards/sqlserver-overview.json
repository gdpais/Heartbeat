        {
          "expr": "sum(rate(heartbeat_sqlserver_batch_requests_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval]))",
          "legendFormat": "Batch requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(heartbeat_sqlserver_transactions_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval]))",
          "legendFormat": "Transactions",
          "refId": "B"
        }
      ],
      "title": "Throughput (per second)",
      "type": "timeseries",
      "description": "Batch requests and transactions per second, summed over the selected targets. Read from cumulative counters with rate(), so SQL Server restarts do not show as drops."
    },
