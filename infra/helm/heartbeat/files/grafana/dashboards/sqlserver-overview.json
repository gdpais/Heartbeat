        {
          "expr": "histogram_quantile(0.95, sum by (probe, le) (rate(heartbeat_collector_probe_duration_seconds_bucket{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ],
      "title": "Probe Duration (p95)",
      "type": "timeseries",
      "description": "95th percentile probe query duration, by probe, over the selected targets. Includes failed and timed-out probes; probes that never started are not measured."
