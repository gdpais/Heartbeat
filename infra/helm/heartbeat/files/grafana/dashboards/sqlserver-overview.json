        }
      },
      "targets": [
        {
          "expr": "sum by (target, file_type) (rate(heartbeat_sqlserver_database_file_read_stall_seconds_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])) / (sum by (target, file_type) (rate(heartbeat_sqlserver_database_file_reads_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{target}} {{file_type}} read",
          "refId": "A"
        },
        {
          "expr": "sum by (target, file_type) (rate(heartbeat_sqlserver_database_file_write_stall_seconds_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])) / (sum by (target, file_type) (rate(heartbeat_sqlserver_database_file_writes_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{target}} {{file_type}} write",
          "refId": "B"
        }
      ],
      "title": "File I/O Latency (average per operation)",
      "type": "timeseries",
      "description": "Average time SQL Server waited per read or write, by file type (ROWS data files, LOG transaction log): I/O stall time divided by operations over the same window. No point is drawn while a file type had no operations, instead of dividing by zero."
    },
