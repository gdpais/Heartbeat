          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (wait_type) (rate(heartbeat_sqlserver_wait_seconds_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "{{wait_type}}",
          "refId": "A"
        }
      ],
      "title": "Top Wait Types (seconds waited per second)",
      "type": "timeseries",
      "description": "Seconds spent waiting per second, by wait type, summed over the selected targets: 2 means on average two tasks were waiting on that type. Read from the cumulative wait counter with rate(), so SQL Server restarts and cleared wait statistics do not show as drops."
    },
