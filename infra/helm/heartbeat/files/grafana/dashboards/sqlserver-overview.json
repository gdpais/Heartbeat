        {
          "expr": "sum by (probe, reason) (rate(heartbeat_collector_probe_errors_total{environment=~\"$environment\",target=~\"$target\"}[$__rate_interval])) * 60",
          "legendFormat": "{{probe}} {{reason}}",
          "refId": "A"
