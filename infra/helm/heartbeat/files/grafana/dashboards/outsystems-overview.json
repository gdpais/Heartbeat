      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Where",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Top operations",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(20, sum by (application, module, log_type, operation) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__range])))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, module, log_type, operation) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\"}[$__range])) / sum by (application, module, log_type, operation) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__range]))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests / s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.001
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "module"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Latency of this module",
                    "url": "/d/outsystems-latency/outsystems-latency?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-module=${__value.raw}"
                  },
                  {
                    "title": "Errors of this module",
                    "url": "/d/outsystems-errors/outsystems-errors?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-module=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Requests / s",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
