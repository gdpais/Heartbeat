{
  "annotations": {
    "list": []
  },
  "description": "Requests, SLOs, users and dependencies of OutSystems 11 applications, from their logging database.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "outsystems"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "OutSystems",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "SQL Server Overview",
      "url": "/d/sqlserver-overview/sql-server-overview",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "The databases at the same time"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests and SLOs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "User-facing requests (screens, Reactive server calls, exposed APIs) per second, over 5 minutes. The metrics are counted when the collector extracts a row, so they trail real time by the log type's lag plus the poll interval, about a minute by default.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Failed requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\"}[5m])) / sum(rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Share of user-facing requests with an error over 5 minutes. Red above the 0.1% error objective.",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Slower than 2 s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum(rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",le=~\"2(\\\\.0)?\"}[5m])) / sum(rate(heartbeat_outsystems_operation_duration_seconds_count{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Share of user-facing requests slower than the 2 s latency threshold over 5 minutes. Red above the 1% objective.",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "95th percentile of user-facing request duration over 5 minutes.",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Error budget burn (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(heartbeat:outsystems_request_errors:ratio_rate1h{environment=~\"$environment\",application=~\"$application\"}) / 0.001",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "How fast the worst selected application spends its error budget (99.9% over 30 days): 1 spends it exactly in 30 days. The burn-rate alerts fire at 6 (warning, with 30m) and 14.4 (critical, with 5m).",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Active users (5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (User_Id) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\"} | User_Id!=\"\" | User_Id!=\"0\" [5m]))) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "Distinct signed-in users in the last 5 minutes, counted by Loki from the User_Id of every log row (the collector does not count users on purpose).",
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Active sessions (5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (Session_Id) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\"} | Session_Id!=\"\" [5m]))) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "Distinct sessions in the last 5 minutes, from Loki. Stateless API calls count one session each.",
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Extraction lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(heartbeat_outsystems_extract_lag_seconds{environment=~\"$environment\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "How far Heartbeat's extraction is behind, worst log type. OutSystemsLogExtractionBehind fires above 30 minutes; while it is high, the SLIs above go quiet rather than red.",
      "id": 9,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by log type and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (log_type, outcome) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{log_type}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Screens, Reactive server calls and exposed APIs per second. The metrics are counted when the collector extracts a row, so they trail real time by the log type's lag plus the poll interval, about a minute by default.",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Failed requests by application",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\"}[$__rate_interval])) / sum by (application) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Share of failed user-facing requests; the dashed line is the 0.1% error objective.",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\"}[$__rate_interval])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "User-facing request duration; the dashed line is the 2 s latency threshold.",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "SLO burn rates",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "heartbeat:outsystems_request_errors:ratio_rate1h{environment=~\"$environment\",application=~\"$application\"} / 0.001",
          "refId": "A",
          "legendFormat": "errors 1h {{application}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "heartbeat:outsystems_request_errors:ratio_rate5m{environment=~\"$environment\",application=~\"$application\"} / 0.001",
          "refId": "B",
          "legendFormat": "errors 5m {{application}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "heartbeat:outsystems_request_slow:ratio_rate1h{environment=~\"$environment\",application=~\"$application\"} / 0.01",
          "refId": "C",
          "legendFormat": "latency 1h {{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
