          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (module, le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",module=~\"$module\",log_type=~\"$log_type\"}[$__rate_interval]))))",
          "refId": "A",
