    {
      "type": "stat",
      "title": "Slower than 2 s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum(rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",module=~\"$module\",log_type=~\"$log_type\",le=~\"2(\\\\.0)?\"}[5m])) / sum(rate(heartbeat_outsystems_operation_duration_seconds_count{environment=~\"$environment\",application=~\"$application\",module=~\"$module\",log_type=~\"$log_type\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Share of the selected entry points slower than the 2 s threshold over 5 minutes.",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "p95 by log type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (log_type, le) (rate(heartbeat_outsystems_operation_duration_seconds_bucket{environment=~\"$environment\",application=~\"$application\",module=~\"$module\",log_type=~\"$log_type\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{log_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Screens, Reactive server calls, exposed APIs and timers.",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
