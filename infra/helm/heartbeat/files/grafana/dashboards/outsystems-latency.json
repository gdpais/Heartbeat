    {
      "type": "table",
      "title": "Requests slower than 2 s",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\"$log_type\"} | Espace_Name=~\"$module\" | Duration > 2000",
          "refId": "A",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request_Key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Request timeline",
                    "url": "/d/outsystems-request/outsystems-request-timeline?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-request_key=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "outsystems_log_type",
                "Espace_Name",
                "Screen",
                "Action_Name",
                "Duration",
                "Username",
                "Server",
                "Request_Key",
                "Line"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "outsystems_log_type": 1,
              "Espace_Name": 2,
              "Screen": 3,
              "Action_Name": 4,
              "Duration": 5,
              "Username": 6,
              "Server": 7,
              "Request_Key": 8,
              "Line": 9
            },
            "renameByName": {
              "Line": "Message",
              "outsystems_log_type": "Log type",
              "Espace_Name": "Module",
              "Screen": "Entry point",
              "Action_Name": "Action"
            }
          }
        }
      ],
      "description": "Entry points over the threshold, newest first. Click a Request_Key for its integrations, slow SQL and errors.",
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      }
