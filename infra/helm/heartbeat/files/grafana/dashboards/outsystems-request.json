{
  "annotations": {
    "list": []
  },
  "description": "One request across log types and modules, by its Request_Key, and the requests of a user or session.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "outsystems"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "OutSystems",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "SQL Server Overview",
      "url": "/d/sqlserver-overview/sql-server-overview",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "The databases at the same time"
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\"screen|mobile_request|integration|cyclic_job\"} | Username=~\"${user:regex}.*\" | Session_Id=~\"${session:regex}.*\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request_Key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Request timeline",
                    "url": "/d/outsystems-request/outsystems-request-timeline?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-request_key=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "outsystems_log_type",
                "Espace_Name",
                "Screen",
                "Action_Name",
                "Duration",
                "Username",
                "Session_Id",
                "Client_IP",
                "Request_Key",
                "Line"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "outsystems_log_type": 1,
              "Espace_Name": 2,
              "Screen": 3,
              "Action_Name": 4,
              "Duration": 5,
              "Username": 6,
              "Session_Id": 7,
              "Client_IP": 8,
              "Request_Key": 9,
              "Line": 10
            },
            "renameByName": {
              "Line": "Message",
              "outsystems_log_type": "Log type",
              "Espace_Name": "Module",
              "Screen": "Entry point",
              "Action_Name": "Action"
            }
          }
        }
      ],
      "description": "Entry points in the time range, newest first, filtered by the Username and Session boxes (a session prefix such as a PatientZero run id works). Click a Request_Key to show that request below.",
      "id": 1,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Timeline of the request",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\".+\"} | Request_Key!=\"\" | Request_Key=\"$request_key\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request_Key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Request timeline",
                    "url": "/d/outsystems-request/outsystems-request-timeline?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-request_key=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "outsystems_log_type",
                "Espace_Name",
                "Screen",
                "Action_Name",
                "Duration",
                "Error_Id",
                "Server",
                "Request_Key",
                "Line"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "outsystems_log_type": 1,
              "Espace_Name": 2,
              "Screen": 3,
              "Action_Name": 4,
              "Duration": 5,
              "Error_Id": 6,
              "Server": 7,
              "Request_Key": 8,
              "Line": 9
            },
            "renameByName": {
              "Line": "Message",
              "outsystems_log_type": "Log type",
              "Espace_Name": "Module",
              "Screen": "Entry point",
              "Action_Name": "Action"
            }
          }
        }
      ],
      "description": "Every row the request logged, across log types and modules, oldest first: the entry point, the integrations and extensions it called, slow SQL and errors. Instant is the start for screens and timers and the end for integrations and Reactive server calls.",
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "logs",
      "title": "Messages of the request",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\".+\"} | Request_Key!=\"\" | Request_Key=\"$request_key\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "description": "The same rows with their full message and stack.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "bargauge",
      "title": "Rows carrying a Request_Key",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outsystems_log_type) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\".+\"} | Request_Key!=\"\" [$__range])) / sum by (outsystems_log_type) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=~\".+\"} [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{outsystems_log_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Share of each log type's rows in the time range that carry a Request_Key: how far a timeline built from it can be trusted for that log type.",
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 27
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "heartbeat",
    "outsystems"
  ],
