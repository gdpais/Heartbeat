        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(heartbeat_outsystems_operations_total{environment=~\"$environment\"}, application)",
          "refId": "application-var"
        },
        "definition": "label_values(heartbeat_outsystems_operations_total{environment=~\"$environment\"}, application)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "module",
        "label": "Module",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\"}, module)",
          "refId": "module-var"
        },
        "definition": "label_values(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\"}, module)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
