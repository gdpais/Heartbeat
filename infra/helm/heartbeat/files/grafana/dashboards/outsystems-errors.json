{
  "annotations": {
    "list": []
  },
  "description": "What fails, where and for whom: the error log and failed requests of OutSystems 11 applications.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "outsystems"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "OutSystems",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "SQL Server Overview",
      "url": "/d/sqlserver-overview/sql-server-overview",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "The databases at the same time"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Errors / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(heartbeat_outsystems_errors_total{environment=~\"$environment\",application=~\"$application\",module=~\"$module\"}[5m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "Rows written to the error log per minute, over 5 minutes. The metrics are counted when the collector extracts a row, so they trail real time by the log type's lag plus the poll interval, about a minute by default.",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Failed requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\",module=~\"$module\"}[5m])) / sum(rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",module=~\"$module\",log_type=~\"screen|mobile_request|integration\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Share of user-facing requests with an error over 5 minutes.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Distinct errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (error_fingerprint) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=\"error\"} | Espace_Name=~\"$module\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "Distinct error fingerprints (message and stack) in the time range.",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Users affected",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (User_Id) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=\"error\"} | Espace_Name=~\"$module\" | User_Id!=\"\" | User_Id!=\"0\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "description": "Distinct signed-in users with at least one error in the time range.",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by module",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (module) (rate(heartbeat_outsystems_errors_total{environment=~\"$environment\",application=~\"$application\",module=~\"$module\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Error log rows per minute by module.",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Failed requests by log type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (log_type) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\",module=~\"$module\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{log_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "User-facing requests that failed, per second.",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      }
    },
    {
      "type": "table",
      "title": "Top errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (error_fingerprint, Espace_Name, Screen, Action_Name) (count_over_time({service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=\"error\"} | Espace_Name=~\"$module\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Fingerprint"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Only this error",
                    "url": "/d/outsystems-errors/outsystems-errors?${__url_time_range}&${environment:queryparam}&${application:queryparam}&${module:queryparam}&var-fingerprint=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Count",
              "Espace_Name": "Module",
              "Screen": "Entry point",
              "Action_Name": "Action",
              "error_fingerprint": "Fingerprint"
            }
          }
        }
      ],
      "description": "The most frequent errors in the time range, grouped by fingerprint (the whole message and stack).",
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "table",
      "title": "Failed operations",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(20, sum by (module, log_type, operation) (increase(heartbeat_outsystems_operations_total{environment=~\"$environment\",application=~\"$application\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\",module=~\"$module\"}[$__range]))) > 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Failed",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Failed"
            }
          }
        }
      ],
      "description": "Screens, server calls and exposed APIs with the most failed requests in the time range.",
      "id": 8,
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by front-end server",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (front_end) (rate(heartbeat_outsystems_front_end_operations_total{environment=~\"$environment\",application=~\"$application\",outcome=\"error\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{front_end}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Failed entry-point rows per second by front-end server: errors on one server only point at the node.",
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 12
      }
    },
    {
      "type": "table",
      "title": "Recent errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=\"error\"} | Espace_Name=~\"$module\" | error_fingerprint=~\"${fingerprint:regex}.*\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request_Key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Request timeline",
                    "url": "/d/outsystems-request/outsystems-request-timeline?${__url_time_range}&${environment:queryparam}&${application:queryparam}&var-request_key=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "Espace_Name",
                "Screen",
                "Action_Name",
                "Username",
                "Server",
                "error_fingerprint",
                "Request_Key",
                "Line"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "Espace_Name": 1,
              "Screen": 2,
              "Action_Name": 3,
              "Username": 4,
              "Server": 5,
              "error_fingerprint": 6,
              "Request_Key": 7,
              "Line": 8
            },
            "renameByName": {
              "Line": "Message",
              "Espace_Name": "Module",
              "Screen": "Entry point",
              "Action_Name": "Action"
            }
          }
        }
      ],
      "description": "The newest error rows, of one fingerprint when the Fingerprint box is set. Click a Request_Key for everything that request logged.",
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "logs",
      "title": "Error log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$application\",deployment_environment_name=~\"$environment\",outsystems_log_type=\"error\"} | Espace_Name=~\"$module\" | error_fingerprint=~\"${fingerprint:regex}.*\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "description": "The error log itself; open a row for its stack and every field.",
      "id": 11,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "heartbeat",
    "outsystems"
  ],
  "templating": {
    "list": [
      {
