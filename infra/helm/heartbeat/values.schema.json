{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heartbeat chart values",
  "description": "Validates the embedded integrations.yaml and the collectors the Heartbeat API renders into managedCollectors, the db-collector and backend NetworkPolicies, the db-collector state volume settings, and the OTel Collector export queue volume. properties.integrations is a copy of packages/config-schema/src/integrations.schema.json (without $schema); tests/chart_schema_test.go fails when they differ. Unknown top-level keys are rejected, so a misspelt value such as dbColector fails instead of being ignored; every key values.yaml sets must be listed here (tests/chart_schema_test.go).",
  "type": "object",
  "required": [
    "integrations"
  ],
  "additionalProperties": false,
  "properties": {
    "dbCollector": {
      "type": "object",
      "description": "The db-collector. Unknown keys are rejected, so a misspelt key fails the install instead of being ignored.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "description": "An image digest, sha256: and 64 hex digits, without the @; set, it replaces the tag.",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "adminToken": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secret holding the bearer token for the admin endpoints.",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secret with a HEARTBEAT_CREDENTIAL_<REF> key per credential_ref, mounted as files the collector reads on every connection; empty mounts none.",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "configWatchInterval": {
          "type": "string",
          "description": "How often the collector re-reads integrations.yaml (Go duration)."
        },
        "sqlserver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trustServerCertificate": {
              "type": "boolean"
            }
          }
        },
        "persistence": {
          "description": "State volume for the outsystems_logs watermarks, mounted at /var/lib/heartbeat. Disabled means an emptyDir.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "size"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            },
            "externalTrafficPolicy": {
              "enum": [
                null,
                "Cluster",
                "Local"
              ]
            }
          }
        },
        "networkPolicy": {
          "description": "Ingress NetworkPolicy for the collector's port 8082. The bundled Prometheus is allowed when prometheus.enabled; scrapers (other metrics scrapers) and operators add NetworkPolicyPeer objects.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "scrapers",
            "operators"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scrapers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            },
            "operators": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            },
            "egress": {
              "description": "Egress NetworkPolicy for the collector, off by default: DNS, the bundled OTel Collector, the monitored databases (targets) and extraRules only.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/networkPolicyPeer"
                  }
                },
                "dns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/networkPolicyPeer"
                  }
                },
                "extraRules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "to"
                    ],
                    "properties": {
                      "to": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/networkPolicyPeer"
                        }
                      },
                      "ports": {
                        "description": "NetworkPolicyPort objects; a rule without ports allows every port to its peers.",
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "protocol": {
                              "type": "string",
                              "enum": [
                                "TCP",
                                "UDP",
                                "SCTP"
                              ]
                            },
                            "port": {
                              "oneOf": [
                                {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 65535
                                },
                                {
                                  "type": "string",
                                  "minLength": 1
                                }
                              ]
                            },
                            "endPort": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "description": "Kubernetes ResourceRequirements.",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "goMemLimit": {
          "description": "GOMEMLIMIT for the collector, such as 200MiB, or off. Empty means 80% of resources.limits.memory.",
          "type": "string",
          "pattern": "^$|^off$|^[0-9]+(B|KiB|MiB|GiB|TiB)?$"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "backendNetworkPolicies": {
      "description": "Ingress NetworkPolicies for the bundled OTel Collector, Prometheus, Alertmanager and Loki. Each admits the bundled components that use the engine, on their ports, plus its extraPeers (NetworkPolicyPeer objects).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "otelCollector",
        "prometheus",
        "alertmanager",
        "loki"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "otelCollector": {
          "description": "Admitted to the OTLP ports 4317 and 4318, and to 8889 when the prom-exporter port is on.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extraPeers"
          ],
          "properties": {
            "extraPeers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            }
          }
        },
        "prometheus": {
          "description": "Admitted to 9090.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extraPeers"
          ],
          "properties": {
            "extraPeers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            }
          }
        },
        "alertmanager": {
          "description": "Admitted to 9093.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extraPeers"
          ],
          "properties": {
            "extraPeers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            }
          }
        },
        "loki": {
          "description": "Admitted to 3100.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extraPeers"
          ],
          "properties": {
            "extraPeers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/networkPolicyPeer"
              }
            }
          }
        }
      }
    },
    "otelCollectorQueue": {
      "type": "object",
      "properties": {
        "persistence": {
          "description": "Volume for the OTel Collector's logs export queue, the otel-collector-queue claim. Disabled means the export-queue volume in otelCollector.extraVolumes is an emptyDir.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "size"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Kubernetes v1 PodSecurityContext for the Heartbeat workloads. Its fields are listed, so a misspelt one, such as runAsNonroot, fails instead of leaving the pod without it.",
      "properties": {
        "appArmorProfile": {},
        "fsGroup": {},
        "fsGroupChangePolicy": {},
        "runAsGroup": {},
        "runAsNonRoot": {},
        "runAsUser": {},
        "seLinuxChangePolicy": {},
        "seLinuxOptions": {},
        "seccompProfile": {},
        "supplementalGroups": {},
        "supplementalGroupsPolicy": {},
        "sysctls": {},
        "windowsOptions": {}
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Kubernetes v1 SecurityContext for the Heartbeat containers, its fields listed as for podSecurityContext.",
      "properties": {
        "allowPrivilegeEscalation": {},
        "appArmorProfile": {},
        "capabilities": {},
        "privileged": {},
        "procMount": {},
        "readOnlyRootFilesystem": {},
        "runAsGroup": {},
        "runAsNonRoot": {},
        "runAsUser": {},
        "seLinuxOptions": {},
        "seccompProfile": {},
        "windowsOptions": {}
      }
    },
    "prometheusRules": {
      "description": "Heartbeat's Prometheus rule files, in the heartbeat-prometheus-rules ConfigMap.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configReloadAlert": {
          "description": "The HeartbeatCollectorConfigReloadFailed alert: the db-collector rejected or could not apply its last config change. Disabled leaves its rule file out of the ConfigMap.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "grafanaDashboards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "description": "Helm's global values, passed to every subchart.",
      "type": "object"
    },
    "prometheus": {
      "description": "Values of the prometheus subchart (Prometheus and Alertmanager), checked by its own schema.",
      "type": "object"
    },
    "grafana": {
      "description": "Values of the grafana subchart.",
      "type": "object"
    },
    "loki": {
      "description": "Values of the loki subchart, checked by its own schema.",
      "type": "object"
    },
    "otelCollector": {
      "description": "Values of the opentelemetry-collector subchart (alias otelCollector), checked by its own schema.",
      "type": "object"
    },
    "integrations": {
      "$id": "https://heartbeat.local/schemas/integrations.schema.json",
      "title": "Heartbeat Integrations Config",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectors"
      ],
      "properties": {
        "platform": {
          "description": "Observability platform that stores and shows Heartbeat's telemetry (ADR 0011). Heartbeat only writes OTLP to opentelemetry.endpoint and Prometheus exposition on /metrics; grafana selects Grafana dashboard and deep-link syntax and, later, the API's query adapters; generic is any other platform, for which dashboards, logs and alerting stay empty.",
          "type": "string",
          "enum": [
            "grafana",
            "generic"
          ],
          "default": "grafana"
        },
        "dashboards": {
          "description": "The platform's UI (Grafana): base URL and dashboard and deep-link templates.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "dashboard_templates": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "deep_link_templates": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "logs": {
          "description": "The platform's log query API (Loki). Heartbeat never writes logs here; they go through opentelemetry.endpoint.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "alerting": {
          "description": "The platform's alert API (Alertmanager).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "opentelemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "notification_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "channel_type",
              "target_ref"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "channel_type": {
                "type": "string"
              },
              "target_ref": {
                "type": "string"
              },
              "credential_ref": {
                "type": "string"
              },
              "config": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "credential_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "collectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "credential_ref": {
                "type": "string"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "environment": {
                    "type": "string"
                  },
                  "scrape_interval": {
                    "type": "string",
                    "description": "How often the collector runs a cycle (Go duration, default 30s). For outsystems_logs it is the poll interval."
                  },
                  "lag": {
                    "type": "string",
                    "description": "outsystems_logs only: how far behind now a read stops (Go duration, default 60s)."
                  },
                  "batch_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50000,
                    "description": "outsystems_logs only: most rows one log-type query returns (default 5000)."
                  },
                  "initial_lookback": {
                    "type": "string",
                    "description": "outsystems_logs only: where a log type without a watermark starts, back from now (Go duration, default 15m)."
                  },
                  "log_timezone": {
                    "type": "string",
                    "description": "outsystems_logs only: IANA time zone the Instant column is stored in (default UTC)."
                  },
                  "recount_window": {
                    "type": "string",
                    "description": "outsystems_logs only: how far behind its watermark each log type recounts its rows, once a minute, to find rows committed past the lag (0s off, or whole minutes from 2m to 1h; default 10m)."
                  },
                  "max_derived_series": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "description": "outsystems_logs only: the most series the derived OutSystems metrics may hold for this collector, counted as Prometheus stores them (a histogram's buckets, sum and count each); past it, rows that need a new series are dropped from the derived metrics and counted in heartbeat_outsystems_derived_series_overflow_total (default 50000)."
                  },
                  "target_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "probes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/probe"
                    }
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/target"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "$defs": {
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "query_template": {
              "type": "string"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25000
            },
            "max_rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "description": "sqlserver only: the most rows the probe may return before it fails; default 10000."
            },
            "lag": {
              "type": "string",
              "description": "outsystems_logs only: this log type's lag, replacing the collector's (Go duration). A screen or cyclic_job row is written when the operation ends but Instant is its start, so set it above the longest screen request or timer."
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "host",
            "port"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database_name": {
              "type": "string"
            },
            "credential_ref": {
              "type": "string"
            },
            "probes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/probe"
              }
            }
          }
        }
      }
    },
    "managedCollectors": {
      "description": "Collectors the Heartbeat API renders from approved probe assignments into one generated values file (ADR 0014). The chart appends them to integrations.collectors in the rendered integrations.yaml, so hand-written collectors stay in the environment's own values. Each is a collector as in integrations.collectors, of kind sqlserver, with an id that starts with api-. An id may appear only once across both lists; the chart's templates check that, which a schema cannot.",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://heartbeat.local/schemas/integrations.schema.json#/properties/collectors/items"
          },
          {
            "properties": {
              "id": {
                "pattern": "^api-"
              },
              "kind": {
                "const": "sqlserver"
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "description": "The api- collector id prefix is reserved for managedCollectors (ADR 0014): a hand-written collector in integrations.collectors may not use it. Leading whitespace does not hide the prefix, since the collector trims ids. This sits outside properties.integrations, which must stay an exact copy of the integrations schema: the rendered integrations.yaml holds the api- collectors too.",
      "properties": {
        "integrations": {
          "properties": {
            "collectors": {
              "items": {
                "properties": {
                  "id": {
                    "not": {
                      "pattern": "^\\s*api-"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "networkPolicyPeer": {
      "description": "A Kubernetes NetworkPolicyPeer: a podSelector, a namespaceSelector (or both), or an ipBlock. An empty peer, or one that is only an empty selector (every pod in the namespace or every namespace), is rejected.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": {
          "$ref": "#/$defs/labelSelector"
        },
        "namespaceSelector": {
          "$ref": "#/$defs/labelSelector"
        },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "podSelector"
            ],
            "maxProperties": 1,
            "properties": {
              "podSelector": {
                "maxProperties": 0
              }
            }
          },
          {
            "required": [
              "namespaceSelector"
            ],
            "maxProperties": 1,
            "properties": {
              "namespaceSelector": {
                "maxProperties": 0
              }
            }
          }
        ]
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "minItems": 1
        }
      },
      "description": "A label selector. matchLabels and matchExpressions must not be empty when present, so an empty selector is always written {}."
    }
  }
}
