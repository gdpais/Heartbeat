# Reference only: `make sqlserver-dev-init` writes .env.sqlserver-dev with
# random per-machine passwords. sa only sets up the container; the collector
# logs in as heartbeat_collector, which `make sqlserver-dev-up` creates with
# only the documented grants. Use different passwords.
MSSQL_SA_PASSWORD=CHANGE_ME
HEARTBEAT_CREDENTIAL_ENV_SQLSERVER_DEV=heartbeat_collector:CHANGE_ME_TOO
